# Storage
DATABASE_URL=sqlite:///pr_job_matcher.db

# GitHub PR Ingestion
GITHUB_TOKEN=
GITHUB_USERNAME=backend-eng
GITHUB_REPOS=owner/core-api,owner/batch-workers

# Semantic LLM Matcher (OpenAI-compatible endpoint)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Delivery / Notifications
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=

# Scoring & Veto Thresholds
MIN_JD_LENGTH=150
MAX_REPOST_THRESHOLD=3
PITCH_THRESHOLD=70.0
EXCLUDE_SI=true
REVIEW_WEIGHT_INTERVIEW=0.4
REVIEW_WEIGHT_EMPLOYEE=0.6

# Proprietary scrubbing (comma-separated internal client/domain names)
PROPRIETARY_TERMS=InternalClientA,LegacyVendorB
